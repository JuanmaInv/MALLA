{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.3",
  "body": [
    {
      "type": "TextBlock",
      "text": "Progreso Académico",
      "weight": "Bolder",
      "size": "Medium"
    },
    {
      "type": "FactSet",
      "facts": [
        {
          "title": "Materias Aprobadas:",
          "value": "${approvedSubjects}"
        },
        {
          "title": "Total Materias:",
          "value": "${totalSubjects}"
        },
        {
          "title": "Progreso:",
          "value": "${progressPercentage}%"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.OpenUrl",
      "title": "Ver Detalles",
      "url": "https://ucp-carreras-malla.vercel.app/?view=progress"
    }
  ]
}
